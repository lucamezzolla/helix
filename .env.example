# Helix environment example
#
# Copy this file to .env and fill only the values you need.
#
# IMPORTANT:
# - Do not commit .env.
# - For v0.2.0-prelive, use Coinbase/CDP View-only permissions.
# - Do not enable Trade, Transfer or Withdraw permissions yet.
# - Real order execution is intentionally disabled by the normal Makefile build.

# Coinbase Advanced Trade / CDP API key.
# Expected format:
# COINBASE_API_KEY=organizations/.../apiKeys/...
COINBASE_API_KEY=

# Coinbase ECDSA private key.
# Keep newlines encoded as \n on one line.
# Expected format:
# COINBASE_API_SECRET=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n
COINBASE_API_SECRET=

# Future real-trading flags.
# Leave commented/disabled in v0.2.0-prelive.
#
# Even if these are set to true, the normal Makefile build still does not enable
# real order execution because HELIX_ENABLE_REAL_COINBASE_ORDERS is not compiled in.
#
# HELIX_REAL_TRADING_ENABLED=false
# HELIX_ALLOW_COINBASE_ORDERS=false
# HELIX_I_UNDERSTAND_REAL_MONEY_RISK=false

# Dedicated gate for future real slot-based SELL.
# Keep false unless explicitly testing guarded SELL release candidates.
HELIX_ALLOW_REAL_SLOT_SELL=false
