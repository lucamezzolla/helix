# Helix Coinbase credentials
#
# Do NOT commit your real .env file.
# Use a read-only Coinbase/CDP key only.
#
# Required format:
# COINBASE_API_KEY=organizations/.../apiKeys/...
# COINBASE_API_SECRET=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n

COINBASE_API_KEY=
COINBASE_API_SECRET=
